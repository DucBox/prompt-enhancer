# Copy file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore nên không bao giờ bị đẩy lên GitHub.

# --- Model sinh dữ liệu (step 1a, 2a) ---
# Chỉ cần phần gốc, code tự nối "/v1/chat/completions"
LLM_BASE_URL=http://your-endpoint-here:30080
# Endpoint nội bộ không kiểm tra key -> để TRỐNG (header sẽ là "Bearer ", đúng như lệnh curl)
LLM_API_KEY=
LLM_MODEL=DeepSeek-V4-Flash

# --- Model chấm lọc (step 2b) ---
# ĐỂ TRỐNG cả 3 dòng -> step 2b dùng lại đúng model ở trên. Đây là mặc định.
# Chỉ điền khi muốn chấm bằng model khác họ để tránh thiên vị.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# --- Tuỳ chọn ---
LLM_TIMEOUT=120
LLM_MAX_RETRIES=4
